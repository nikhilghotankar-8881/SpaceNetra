# SpaceNetra Environment Variables Template
# Copy this file to .env and configure local values

# System & Computing
DEVICE=auto
NUM_WORKERS=4
SEED=42

# Project Paths (optional overrides)
DATA_DIR=data
CHECKPOINTS_DIR=checkpoints
OUTPUTS_DIR=outputs
LOG_LEVEL=INFO

# Backend & Database (for later phases)
DATABASE_URL=postgresql://spacenetra:spacenetra@localhost:5432/spacenetradb
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-this-in-production-super-secret-key

# External Satellite APIs (for later phases)
COPERNICUS_API_KEY=
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
